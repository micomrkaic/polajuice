# raw files and sidecars dropped into a checkout for testing, and the
# Polaroid cube make fetch-polaroid-lut leaves at the root
*.DNG
*.dng
*.NEF
*.nef
*.xmp
/*.cube
# synthetic raw test files (tools/make_test_raws.py), a few KB each;
# this must stay below the raw ignores above, since the last match wins
!tests/raw/*
